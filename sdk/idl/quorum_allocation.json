  "types": [
    {
      "name": "AllocationConsensus",
      "docs": [
        "Per weight-round consensus, independent of any `DataFeed` tick. Aggregates the",
        "consumers' venue-weight vectors into the published allocation."
      ],
      "serialization": "bytemuck",
      "repr": {
        "kind": "c"
      },
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "round",
            "type": "u64"
          },
          {
            "name": "closes_at_slot",
            "type": "u64"
          },
          {
            "name": "status",
            "type": "u8"
          },
          {
            "name": "min_number",
            "type": "u8"
          },
          {
            "name": "rule",
            "type": "u8"
          },
          {
            "name": "trim_pct",
            "type": "u8"
          },
          {
            "name": "count",
            "type": "u8"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "output",
            "type": {
              "array": [
                "u16",
                16
              ]
            }
          },
          {
            "name": "submissions",
            "type": {
              "array": [
                {
                  "defined": {
                    "name": "WeightSubmission"
                  }
                },
                100
              ]
            }
          },
          {
            "name": "_pad",
            "type": {
              "array": [
                "u8",
                2
              ]
            }
          }
        ]
      }
    },
    {
      "name": "AllocationState",
      "docs": [
        "The published allocation weight vector — a small, stable read target for",
        "the vault core (the vault reads this one PDA). Written by `finalize_allocation`."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "round",
            "type": "u64"
          },
          {
            "name": "updated_slot",
            "type": "u64"
          },
          {
            "name": "weights",
            "type": {
              "array": [
                "u16",
                16
              ]
            }
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "DataFeed",
      "docs": [
        "Per-`(pool_id, data_id)` measured series: identity, trigger config and the",
        "ring buffer. Sized to fit a single Solana account (8-byte discriminator +",
        "~8.2 KB body, well under the 10 KB default).",
        "",
        "Field order is chosen so the struct has no implicit padding: 8-byte fields,",
        "then 4-byte, then 2-byte, then 1-byte, an explicit pad to an 8-byte boundary,",
        "and finally the 8-byte-aligned ring."
      ],
      "serialization": "bytemuck",
      "repr": {
        "kind": "c"
      },
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "tick",
            "type": "u64"
          },
          {
            "name": "last_finalized_slot",
            "type": "u64"
          },
          {
            "name": "last_value",
            "type": "u64"
          },
          {
            "name": "window_slots",
            "type": "u32"
          },
          {
            "name": "min_interval_slots",
            "type": "u32"
          },
          {
            "name": "max_interval_slots",
            "type": "u32"
          },
          {
            "name": "threshold_bps",
            "type": "u16"
          },
          {
            "name": "head",
            "type": "u16"
          },
          {
            "name": "pool_id",
            "type": "u8"
          },
          {
            "name": "data_id",
            "type": "u8"
          },
          {
            "name": "measurand",
            "type": "u8"
          },
          {
            "name": "min_number",
            "type": "u8"
          },
          {
            "name": "rule",
            "type": "u8"
          },
          {
            "name": "trim_pct",
            "type": "u8"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "_pad",
            "type": {
              "array": [
                "u8",
                1
              ]
            }
          },
          {
            "name": "ring",
            "type": {
              "array": [
