# Copy to deployment/devnet/.env; paths may be absolute or relative to the repo.
DEVNET_RPC_URL=https://api.devnet.solana.com
SOURCE_RPC_URL=https://api.mainnet-beta.solana.com
FUNDING_KEYPAIR=testing/devnet/.state/keys/admin.json
PROGRAM_KEYPAIR=testing/devnet/.state/keys/program.json
BUFFER_KEYPAIR=testing/devnet/.state/keys/program-buffer.json
FEED_WINDOWS=120,180,240
PRODUCER_FUND_SOL=0.12
CONSUMER_FUND_SOL=0.04
OBSERVE_SECONDS=360
FLEET_RPC_PORT=18789
FLEET_WEB_PORT=18880
