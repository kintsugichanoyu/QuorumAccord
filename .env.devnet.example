# Optional manual configuration for the legacy allocation harness.
# The recommended runner uses testing/devnet/.state/<network>/config.json and
# injects these variables itself; it does not generate a root .env.devnet file.

# RPC endpoint(s), comma-separated for failover.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Program ids — must match the deployed declare_id!s (anchor keys sync sets them).
PROGRAM_ID=DZGzK8wkxRWyhEorA8SSfPbUvHRAwog8vSsKeLEx4Coz
MOCK_PROGRAM_ID=3fqre3GKxrkcMvszvtc3vsemgjoKE7mDWz9UQtHtv78N

# Keypair files (solana id.json byte-array format).
ADMIN_KEYPAIR=../testing/devnet/.state/keys/admin.json
OP_KEYPAIRS=../testing/devnet/.state/keys/op1.json,../testing/devnet/.state/keys/op2.json,../testing/devnet/.state/keys/op3.json
OUTSIDER_KEYPAIR=../testing/devnet/.state/keys/outsider.json

# Allocation round number; staleness tolerance (slots) used by the verifier.
# Choose a fresh monotonically increasing round (do not reuse 0).
ROUND=1000000
STALENESS_SLOTS=1000000
RUST_LOG=info
