# Template for the devnet e2e harness. scripts/devnet/00_deploy.sh generates the
# real .env.devnet (with deployed program ids and absolute keypair paths); copy
# this only if wiring things up by hand.

# RPC endpoint(s), comma-separated for failover.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Program ids — must match the deployed declare_id!s (anchor keys sync sets them).
PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS
MOCK_PROGRAM_ID=8hZA4nxK7iQbMYtPFbyhHkeQ9u77PHKdKqDwULzXiY88

# Keypair files (solana id.json byte-array format).
ADMIN_KEYPAIR=./keys/admin.json
OP_KEYPAIRS=./keys/op1.json,./keys/op2.json,./keys/op3.json
OUTSIDER_KEYPAIR=./keys/outsider.json

# Allocation round number; staleness tolerance (slots) used by the verifier.
ROUND=0
STALENESS_SLOTS=1000000
RUST_LOG=info
