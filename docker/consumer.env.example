# Copy to docker/consumer.env and replace the program and feed/round mapping.
# Register this signer and open the selected round before starting the consumer.
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=YOUR_DEPLOYED_QUORUM_PROGRAM_PUBLIC_KEY
RUST_LOG=info
FEEDS='[{"pool_id":1,"data_id":0,"venue":0,"role":"apy"},{"pool_id":1,"data_id":1,"venue":0,"role":"crr","cap_bps":10000}]'
ROUND=0
STALENESS_SLOTS=150000
POLL_MS=5000
