# Shared across all containers. The ONLY secrets are the RPC URL(s) and each
# operator's signing keypair — no proprietary API keys anywhere.

# Comma-separated for failover. Slot pinning makes honest RPCs return identical bytes.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com,https://your-backup-rpc

# Deployed program id (replace the placeholder in Anchor.toml / declare_id! too).
PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS

# Per-container operator keypair: JSON byte array (solana-keygen) or base58 secret.
# In production each container ships its own; do NOT share keyrings.
KEYPAIR=[12,34,...]

RUST_LOG=info
