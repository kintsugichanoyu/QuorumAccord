# Copy to docker/producer.env and replace both public-key placeholders.
# The mounted secret supplies KEYPAIR_FILE; do not put KEYPAIR in this file.
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=YOUR_DEPLOYED_QUORUM_PROGRAM_PUBLIC_KEY
RUST_LOG=info
DRIVER=offset_u64
POOL_ID=1
DATA_ID=0
TARGET_ACCOUNT=YOUR_VALIDATED_SOURCE_ACCOUNT_PUBLIC_KEY
OFFSET=8
SCALE_NUM=1
SCALE_DEN=1
POLL_MS=2000
